{
  "document": "AI 视频生产平台数据字典",
  "version": "1.1-draft",
  "basis": "用户上传设计稿.md（修订至 v0.58，2026-10-31）",
  "purpose": "供开发者和代码生成模型理解逻辑实体、字段、约束和待核实项。不是可直接运行的 SQL schema。",
  "rules": [
    "先检查现有 migrations/models/repositories；既有列名和主键优先保持兼容。",
    "正文保存在文件系统/Git，SQLite 保存元数据、状态、关系、Job 快照和成本。",
    "每个业务实体只有一个模块负责写入。",
    "生成 Job、队列和成本记录的唯一真相源是生成中心。",
    "密钥值不得写入数据库、API 响应、前端、日志或 Git。",
    "对标记为 proposed/to_verify 的表和字段，实施前必须在 SPEC_DIFF.md 中确认。"
  ],
  "logical_types": {
    "ID": "SQLite INTEGER PRIMARY KEY / 外键列",
    "TEXT": "Unicode 文本",
    "BOOLEAN": "SQLite INTEGER 0/1，API 层映射 bool",
    "DATETIME": "沿用当前 schema 时间格式；新增列格式需在盘点后统一",
    "JSON_TEXT": "经过 schema 校验的 JSON 字符串",
    "RELATIVE_PATH": "相对配置根目录的受限路径；服务端使用前规范化检查",
    "ENUM": "服务层/Pydantic Literal 白名单；不要未经分析添加破坏扩展的 CHECK",
    "MONEY": "整数最小货币单位或 Decimal 字符串；保留币种/计量单位，不使用浮点作为唯一金额真相"
  },
  "entities": [
    {
      "name": "project",
      "logical_entity": "Project",
      "status": "existing_confirmed_by_design_history_verify_physical_columns",
      "owner_module": "项目中心",
      "description": "项目根对象。active/archived；所有人和成员；项目摘要计数派生查询。",
      "fields": [
        {
          "name": "id",
          "type": "ID",
          "required": true,
          "constraints": [
            "primary_key"
          ],
          "description": "保持现有主键"
        },
        {
          "name": "name",
          "type": "TEXT",
          "required": true,
          "constraints": [
            "trim_nonempty"
          ],
          "description": "项目名称；硬删除确认时精确匹配"
        },
        {
          "name": "description",
          "type": "TEXT",
          "required": true,
          "default": "''",
          "constraints": [
            "max_length_500"
          ],
          "description": "项目介绍"
        },
        {
          "name": "owner_id",
          "type": "ID",
          "required": true,
          "constraints": [
            "FK app_user.id ON DELETE RESTRICT"
          ],
          "description": "项目所有人；创建时取当前登录用户，后续只有所有权转移操作可修改"
        },
        {
          "name": "status",
          "type": "ENUM",
          "required": true,
          "allowed_values": [
            "active",
            "archived"
          ],
          "description": "在产/已归档；由应用层 Literal 校验"
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "DATETIME",
          "required": true,
          "description": "最后内容修改时间；打开和归档不能更新"
        },
        {
          "name": "last_opened_at",
          "type": "DATETIME",
          "required": false,
          "nullable": true,
          "description": "最近打开时间；NULL 表示从未打开"
        }
      ],
      "relations": [
        "1:N episode",
        "1:N asset",
        "1:N document (logical/proposed)",
        "1:N task/job/review/knowledge",
        "N:M app_user through project_member",
        "N:M tags through project_tag"
      ],
      "indexes_recommended": [
        "status,last_opened_at DESC,id DESC",
        "owner_id"
      ]
    },
    {
      "name": "project_tag",
      "logical_entity": "ProjectTag",
      "status": "existing_confirmed_by_design_history_verify_columns",
      "owner_module": "项目中心",
      "description": "项目标签关系，标签查询顺序必须显式 ORDER BY。",
      "fields": [
        {
          "name": "project_id",
          "type": "ID",
          "required": true,
          "constraints": [
            "FK project.id",
            "CASCADE on project delete"
          ]
        },
        {
          "name": "tag",
          "type": "TEXT",
          "required": true,
          "constraints": [
            "max_10_tags_per_project",
            "max_length_20",
            "deduplicate"
          ]
        }
      ],
      "primary_or_unique": [
        "project_id,tag"
      ]
    },
    {
      "name": "project_member",
      "logical_entity": "ProjectMember",
      "status": "existing_confirmed_by_design_history_verify_columns",
      "owner_module": "项目中心",
      "description": "项目协作人关联。所有人不必重复列为协作者。",
      "fields": [
        {
          "name": "project_id",
          "type": "ID",
          "required": true,
          "constraints": [
            "FK project.id ON DELETE CASCADE"
          ]
        },
        {
          "name": "user_id",
          "type": "ID",
          "required": true,
          "constraints": [
            "FK app_user.id ON DELETE CASCADE"
          ]
        },
        {
          "name": "added_by",
          "type": "ID",
          "required": false,
          "nullable": true,
          "description": "如当前表已有则沿用；不要为它创建第二种审计机制"
        }
      ],
      "primary_or_unique": [
        "project_id,user_id"
      ]
    },
    {
      "name": "episode",
      "logical_entity": "Episode",
      "status": "existing_confirmed_by_design_history_verify_columns",
      "owner_module": "创作中心",
      "description": "集/创作单元；项目中心只读展示数量与状态聚合。",
      "fields": [
        {
          "name": "id",
          "type": "ID",
          "required": true,
          "constraints": [
            "primary_key"
          ]
        },
        {
          "name": "project_id",
          "type": "ID",
          "required": true,
          "constraints": [
            "FK project.id"
          ]
        },
        {
          "name": "number",
          "type": "INTEGER",
          "required": true,
          "constraints": [
            "transactional numbering",
            "unique per project recommended"
          ]
        },
        {
          "name": "title",
          "type": "TEXT",
          "required": false,
          "description": "仅在当前 schema 已有时沿用，不臆造物理列"
        },
        {
          "name": "status",
          "type": "ENUM",
          "required": true,
          "allowed_values": [
            "done",
            "other existing values to verify"
          ],
          "description": "必须支持 done；其余从当前 Literal/schema 获取"
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "required": false,
          "description": "实际列名/默认值待核实"
        },
        {
          "name": "updated_at",
          "type": "DATETIME",
          "required": false,
          "description": "实际列名待核实"
        }
      ],
      "relations": [
        "N:1 project",
        "1:N shot"
      ],
      "indexes_recommended": [
        "project_id,number UNIQUE"
      ]
    },
    {
      "name": "asset",
      "logical_entity": "Asset",
      "status": "existing_confirmed_by_design_history_verify_columns",
      "owner_module": "资产中心",
      "description": "角色、场景、道具资产；视觉提示词和参考图；可跨项目引用。",
      "fields": [
        {
          "name": "id",
          "type": "ID",
          "required": true,
          "constraints": [
            "primary_key"
          ]
        },
        {
          "name": "project_id",
          "type": "ID",
          "required": false,
          "nullable": true,
          "constraints": [
            "FK project.id if non-null"
          ],
          "description": "NULL=全局资产仅是建议语义，需核实现有实现和权限"
        },
        {
          "name": "type",
          "type": "ENUM",
          "required": true,
          "allowed_values": [
            "character",
            "scene",
            "prop or existing aliases"
          ],
          "description": "物理取值以当前 Literal 为准"
        },
        {
          "name": "name",
          "type": "TEXT",
          "required": true,
          "constraints": [
            "trim_nonempty",
            "unique within scope+type"
          ]
        },
        {
          "name": "description",
          "type": "TEXT",
          "required": false,
          "description": "视觉外观/资产描述；检查现有列"
        },
        {
          "name": "consistency_prompt",
          "type": "TEXT",
          "required": false,
          "description": "一致性提示词；只在资产中心写入"
        },
        {
          "name": "knowledge_reference",
          "type": "JSON_TEXT or relation",
          "required": false,
          "description": "设定条目关联方式待核实，沿用现有事实来源"
        },
        {
          "name": "reference_images",
          "type": "JSON_TEXT/path relation",
          "required": false,
          "description": "图片实体存储方式待核实；当前文件目录记录为 data/files/<asset_id>/<uuid>.<ext>"
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "required": false,
          "description": "按现有 schema"
        },
        {
          "name": "updated_at",
          "type": "DATETIME",
          "required": false,
          "description": "资产变更时项目 updated_at 一并更新"
        }
      ],
      "indexes_recommended": [
        "scope(project_id),type,name; uniqueness must correctly handle NULL/global scope"
      ]
    },
